# apps/api/.env.example
# Copy to .env and fill in real values
# IronWorks Gym API · SPManchester Private Limited

# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://ironworks:ironworks_dev_password@localhost:5432/ironworks_db"

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://default:ironworks_redis_dev@localhost:6379"

# ── Auth / JWT ────────────────────────────────────────────────
JWT_SECRET="CHANGE_ME_min_32_chars_random_secret_here"
JWT_REFRESH_SECRET="CHANGE_ME_different_min_32_chars_secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── GoCardless Direct Debit ───────────────────────────────────
GOCARDLESS_ACCESS_TOKEN="sandbox_..."
GOCARDLESS_WEBHOOK_SECRET="..."
GOCARDLESS_ENVIRONMENT="sandbox"

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@ironworksgym.com"
EMAIL_FROM_NAME="IronWorks Gym"

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# ── App ───────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# ── Monitoring ────────────────────────────────────────────────
SENTRY_DSN=""

{
  "name": "@ironworks/cms",
  "version": "2.0.0",
  "description": "Payload CMS for IronWorks Gym — Content & Timetable Management",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc --outDir dist --module commonjs --target es2020 --esModuleInterop --skipLibCheck src/server.ts",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "db:generate": "payload generate:types",
    "db:migrate": "payload migrate",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "payload": "^2.30.0",
    "@payloadcms/db-postgres": "^0.8.10",
    "@payloadcms/richtext-lexical": "^0.11.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "author": {
    "name": "Sayed Mudassar Akbar",
    "email": "info@spmanchester.com",
    "url": "https://www.spmanchester.com"
  },
  "license": "MIT"
}
